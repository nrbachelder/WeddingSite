# Copy to .env.local (never commit it). Leave unset to use the built-in mock guest list.
# 1. Google Cloud console → create a service account → create a JSON key
# 2. Enable the Google Sheets API for that project
# 3. Share your RSVP sheet with the service account email (Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=rsvp-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
